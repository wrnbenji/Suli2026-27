@model List<Ugyfel>

<table border="1">
    <thead>
        <tr>
            <td>Márka</td>
            <td>Model</td>
            <td>Aktív?</td>
        </tr>
    </thead>
    <tbody>

        @for (int i = 0; i < Model.Count; i++)
        {
            <tr>
                <td>@Model[i].Nev</td>
                <td>@Model[i].Email</td>
                <td>
                        @(Model[i].Aktiv ? "Igen" : "Nem")
                    </td>
            </tr>
        }

    </tbody>

</table>
