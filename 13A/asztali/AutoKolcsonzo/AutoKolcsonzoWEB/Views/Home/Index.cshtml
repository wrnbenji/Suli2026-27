@{
    ViewData["Title"] = "Főoldal";
}

<section class="ak-hero">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="ak-badge"><i class="bi bi-lightning-charge-fill"></i> Gyors és egyszerű kölcsönzés</span>
            <h1>Vezess bármit,<br /><span class="ak-gradient-text">bármikor.</span></h1>
            <p class="mt-3">Kezeld a flottát, az ügyfeleket és a kölcsönzéseket egyetlen letisztult felületen.</p>
            <div class="d-flex gap-3 flex-wrap mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Auto" asp-action="Szabad">
                    <i class="bi bi-key-fill me-2"></i>Szabad autók
                </a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Auto" asp-action="OsszesAuto">Teljes flotta</a>
            </div>
        </div>
        <div class="col-lg-6 d-none d-lg-flex justify-content-center">
            <div class="ak-hero-visual">
                <i class="bi bi-car-front-fill"></i>
            </div>
        </div>
    </div>
</section>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <a class="ak-card" asp-controller="Auto" asp-action="OsszesAuto">
            <div class="ak-card-icon"><i class="bi bi-car-front-fill"></i></div>
            <h5>Összes autó</h5>
            <p>A teljes flotta egy helyen.</p>
            <span class="ak-more">Megnézem <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a class="ak-card" asp-controller="Auto" asp-action="Szabad">
            <div class="ak-card-icon"><i class="bi bi-check-circle-fill"></i></div>
            <h5>Szabad autók</h5>
            <p>Most azonnal elvihető járművek.</p>
            <span class="ak-more">Megnézem <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a class="ak-card" asp-controller="Ugyfel" asp-action="OsszesUgyfel">
            <div class="ak-card-icon"><i class="bi bi-people-fill"></i></div>
            <h5>Ügyfelek</h5>
            <p>Regisztrált ügyfelek kezelése.</p>
            <span class="ak-more">Megnézem <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a class="ak-card" asp-controller="Ugyfel" asp-action="UjUgyfel">
            <div class="ak-card-icon"><i class="bi bi-person-plus-fill"></i></div>
            <h5>Új ügyfél</h5>
            <p>Új ügyfél felvétele a rendszerbe.</p>
            <span class="ak-more">Hozzáadom <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
</div>