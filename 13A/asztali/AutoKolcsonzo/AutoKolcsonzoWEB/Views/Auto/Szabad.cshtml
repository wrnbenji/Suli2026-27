@model List<Auto>
@{
    ViewData["Title"] = "Szabad autók";
}

<div class="ak-page-header">
    <div>
        <h1>Szabad <span class="ak-gradient-text">autók</span></h1>
        <p>Ezek az autók most azonnal kölcsönözhetők.</p>
    </div>
    <span class="ak-count"><i class="bi bi-car-front-fill me-1"></i> @Model.Count db elérhető</span>
</div>

@if (Model.Count == 0)
{
    <div class="ak-empty">
        <i class="bi bi-emoji-frown"></i>
        <h5>Jelenleg nincs szabad autó</h5>
        <p class="mb-0">Nézz vissza később!</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Márka</th>
                    <th>Modell</th>
                    <th>Állapot</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>
                            <div class="ak-car-name">
                                <span class="ak-car-icon"><i class="bi bi-car-front-fill"></i></span>
                                @Model[i].Gyarto.Nev
                            </div>
                        </td>
                        <td>@Model[i].Modell</td>
                        <td><span class="ak-status">Szabad</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}