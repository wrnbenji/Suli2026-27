@page
@model iskoaliprogWB.Pages.JelentkezesekModel

@if (Model.Jelentkezesek.Count > 0)
{
    <table border="1">
        <tr>
            <td>
                Tanulo
            </td>

            <td>
                Osztaly
            </td>

            <td>
                Program
            </td>

            <td>
                Jelentkezes ideje
            </td>
        </tr>
        @for(int i =0; i< Model.Jelentkezesek.Count; i++)
        {
            <tr>
                <td>
                    @Model.Jelentkezesek[i].TanuloNeve
                </td>

                <td>
                    @Model.Jelentkezesek[i].Osztaly
                </td>

                <td>
                    @Model.Jelentkezesek[i].ProgramTipusa
                </td>

                <td>
                    @Model.Jelentkezesek[i].JelentkezesIdeje
                </td>
            </tr>
        }


    </table>


}
else{
    <p>Nincsenek Adatok</p>
}