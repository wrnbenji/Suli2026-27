@page
@model iskoaliprogWB.Pages.JelentkezesModel

<form method="post">
    @Html.AntiForgeryToken()
    <label>Tanulo Neve:</label>
    <input asp-for="jelentkezes.TanuloNeve" type="text" name="TanuloNeve" id="TanuloNeve" />

    <label>Osztaly:</label>
    <input type="text" asp-for="jelentkezes.Osztaly" name="Osztaly" id="Osztaly" />
    <label>Email:</label>
    <input type="email" asp-for="jelentkezes.Email" name="Email" id="Email" />
    <label>Program:</label>
    <select name="ProgramTipusa" >
      <option value="Robotika szakkör bemutatója"> Robotika szakkör bemutatója</option>
        <option value="Pályaorientációs nap">Pályaorientációs nap</option>
        <option value="Iskolai sportnap">Iskolai sportnap</option>
        <option value="Múzeumlátogatás">Múzeumlátogatás</option>
        <option value="Múzeumlátogatás">Múzeumlátogatás</option>
        
    </select>

    <label>Részvevők Száma:</label>
    <input type="number" min="1" max="5" name="ResztvevokSzama" asp-for="jelentkezes.ResztvevokSzama" id="ResztvevokSzama" />
    <label>Megjegyzés:</label>
    <input type="text" name="Megjegyzes" id="Megjegyzes" asp-for="jelentkezes.Megjegyzes"  />

    <input type="submit" />
</form>